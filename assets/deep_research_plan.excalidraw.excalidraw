			"frameId": null,
			"index": "b0o",
			"roundness": null,
			"seed": 1694691244,
			"version": 761,
			"versionNonce": 923842068,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1771557125681,
			"locked": false,
			"text": "Planner:\n- Plan and create a list of tasks for\neach section\n- each tasks should contain\n    - section name\n    - description of what should be\nwritten\n    - source_names_list\n\n- for sections like intro or conclusion\nor anything like this where overall\nidea of document is required, the\ndescription should contain the exact\ncontent and source list should be\nempty. If possible provide citation\n\n- Context:\n    - all sources and their description\nwith index organized based on\nresearcher query\n    - Original brief",
			"rawText": "Planner:\n- Plan and create a list of tasks for each section\n- each tasks should contain\n    - section name\n    - description of what should be written\n    - source_names_list\n\n- for sections like intro or conclusion or anything like this where overall idea of document is required, the description should contain the exact content and source list should be empty. If possible provide citation\n\n- Context:\n    - all sources and their description with index organized based on researcher query\n    - Original brief",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "ktKA4m9Z",
			"originalText": "Planner:\n- Plan and create a list of tasks for each section\n- each tasks should contain\n    - section name\n    - description of what should be written\n    - source_names_list\n\n- for sections like intro or conclusion or anything like this where overall idea of document is required, the description should contain the exact content and source list should be empty. If possible provide citation\n\n- Context:\n    - all sources and their description with index organized based on researcher query\n    - Original brief",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
