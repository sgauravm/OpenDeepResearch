			"index": "b0pV",
			"roundness": null,
			"seed": 1336793772,
			"version": 735,
			"versionNonce": 462698156,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1771451941314,
			"locked": false,
			"text": "Section Writer\n- Based on provided description and\nsources write the section in markdown\nformat. You are provided with the overall\nstructure and you have to write\n{cur_section}. For your reference previous\nsection has been provided to maintain\nwriting style consistency.\n- Cite sources\n- Do not use # as this will be used as\nsection header. You can use anything from\n##\n- Or ask it to start from # <section name>\n- Context:\n    - overall section info in the form of\nsection names\n    - Previous section text\n    - Source content with id2\n- Output:\n    - markdown text for that section\n",
			"rawText": "Section Writer\n- Based on provided description and sources write the section in markdown format. You are provided with the overall structure and you have to write {cur_section}. For your reference previous section has been provided to maintain writing style consistency.\n- Cite sources\n- Do not use # as this will be used as section header. You can use anything from ##\n- Or ask it to start from # <section name>\n- Context:\n    - overall section info in the form of section names\n    - Previous section text\n    - Source content with id2\n- Output:\n    - markdown text for that section\n",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "o7E1MFHq",
			"originalText": "Section Writer\n- Based on provided description and sources write the section in markdown format. You are provided with the overall structure and you have to write {cur_section}. For your reference previous section has been provided to maintain writing style consistency.\n- Cite sources\n- Do not use # as this will be used as section header. You can use anything from ##\n- Or ask it to start from # <section name>\n- Context:\n    - overall section info in the form of section names\n    - Previous section text\n    - Source content with id2\n- Output:\n    - markdown text for that section\n",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
