		{
			"id": "IQrHluLe",
			"type": "text",
			"x": 2810.05078125,
			"y": 238.234375,
			"width": 289.21575927734375,
			"height": 420,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
